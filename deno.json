{
  "imports": {
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@7bc467897e74d6535a9f10bfe4de94c7d4ceb5ab/",
    "blog/": "https://deno.land/x/lume_theme_simple_blog@v0.16.0/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@ba24aa8acb3eefb1cc0ef88c198c468793bcf286/",
    "lume/jsx-runtime": "https://deno.land/x/ssx@v0.1.10/jsx-runtime.ts"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "prod": "deno task lume --location=https://xeo.land",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "d": "deno task serve",
    "cms": "deno task lume cms",
    "lup": "deno task lume upgrade",
    "lupd": "deno task lume upgrade --dev",
    "up": "deno run -A --quiet 'https://deno.land/x/nudd@v0.2.9/cli.ts' update deno.json"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "lint": {
    "exclude": [
      "./_site"
    ],
    "rules": {
      "tags": [
        "recommended"
      ]
    },
    "plugins": [
      "https://cdn.jsdelivr.net/gh/lumeland/lume@7bc467897e74d6535a9f10bfe4de94c7d4ceb5ab/lint.ts"
    ]
  },
  "fmt": {
    "exclude": [
      "./_site"
    ]
  },
  "unstable": [
    "temporal"
  ]
}
