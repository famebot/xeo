{
  "imports": {
    "lume/": "https://deno.land/x/lume@v3.0.2/",
    "xeo/": "https://deno.land/x/xeo@v6.1.0/",
    "lume/cms/": "https://cdn.jsdelivr.net/gh/lumeland/cms@0.11.5/",
    "lume/jsx-runtime": "https://deno.land/x/ssx@v0.1.10/jsx-runtime.ts"
  },
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "xogo": "deno task lume --location=https://xogo.xeo.land",
    "build": "deno task lume",
    "serve": "deno task lume -s",
    "d": "deno task serve",
    "cms": "deno task lume cms",
    "lup": "deno task lume upgrade",
    "up": "deno run -A --quiet 'https://deno.land/x/nudd@v0.2.9/cli.ts' update deno.json"
  },
  "compilerOptions": {
    "types": [
      "lume/types.ts"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "lume"
  },
  "unstable": [
    "temporal"
  ],
  "lint": {
    "plugins": [
      "https://deno.land/x/lume@v3.0.2/lint.ts"
    ]
  }
}
